---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
export async function getStaticPaths() {
  return (await getCollection("journal")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<"journal"> };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} active="journal">
  <article class="standalone-note page-width"><a href={withBase("journal/")}>← Research Journal</a><div class="document-meta"><span>JOURNAL ENTRY</span><span>{entry.data.updated}</span></div><div class="prose"><Content /></div></article>
</BaseLayout>
