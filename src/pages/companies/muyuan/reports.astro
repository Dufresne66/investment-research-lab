---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import reports from "../../../data/reports/muyuan.json";
import { withBase } from "../../../lib/paths";

const groups = [
  { id: "interim", index: "01", title: "定期报告", description: "当前研究校准文件", items: reports.interim },
  { id: "monthly", index: "02", title: "2026 月度销售简报", description: "高频经营追踪", items: reports.monthly },
  { id: "annual", index: "03", title: "过往年度报告", description: "2021–2025 年完整年报", items: reports.annual },
];
---

<BaseLayout title="牧原官方报告索引" description="牧原股份半年报、月度销售简报与历年年报的官方 PDF 直链。" active="companies">
  <section class="report-library page-width">
    <a class="back-row" href={withBase("companies/muyuan/")}>← 牧原股份</a>
    <p class="section-label">SOURCE LIBRARY · VERIFIED LINKS</p>
    <h1>牧原官方报告索引</h1>
    <p class="report-library-intro">所有按钮均直接打开巨潮资讯 PDF。`HASH VERIFIED` 表示网站所列官方文件与私人研究层本地副本逐字节一致；月报中的阶段性数据未经审计。</p>
    <div class="report-library-actions">
      <a href={withBase("blog/muyuan-2026-h1-review/")}>半年报分析</a>
      <a href={withBase("blog/muyuan-2026-07-sales/")}>7 月简报分析</a>
    </div>

    {groups.map((group) => (
      <section class="report-group" id={group.id}>
        <header><span>{group.index}</span><div><h2>{group.title}</h2><p>{group.description}</p></div></header>
        <div class="report-list">
          {group.items.map((report) => (
            <a href={report.url} target="_blank" rel="noreferrer">
              <time>{report.published}</time>
              <div><strong>{report.title}</strong><small>{report.source_id} · {report.pages} pages</small></div>
              <span class:list={["report-status", report.status === "HASH_VERIFIED" && "hash"]}>{report.status.replaceAll("_", " ")}</span>
              <b>PDF ↗</b>
            </a>
          ))}
        </div>
      </section>
    ))}

    <aside class="source-boundary-note"><b>边界说明</b><p>报告索引只保存公开网址和来源标识，不上传 PDF 文件。页面中的分析数据均指回具体 Source ID 与 PDF 页码。</p></aside>
  </section>
</BaseLayout>
