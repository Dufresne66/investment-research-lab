---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CompanyShell from "../../../layouts/CompanyShell.astro";
import FactCard from "../../../components/FactCard.astro";
import InferenceCard from "../../../components/InferenceCard.astro";
import HypothesisCard from "../../../components/HypothesisCard.astro";
import ThesisCard from "../../../components/ThesisCard.astro";
import EvidenceCard from "../../../components/EvidenceCard.astro";
import RiskCard from "../../../components/RiskCard.astro";

export async function getStaticPaths() {
  const entries = await getCollection("companyResearch");
  const companies = await getCollection("companies");
  const bySlug = new Map(companies.map((entry) => [entry.data.slug, entry]));
  const availableByCompany = new Map<string, string[]>();

  for (const entry of entries) {
    const [companySlug, section] = entry.id.split("/");
    const available = availableByCompany.get(companySlug) ?? [];
    available.push(section);
    availableByCompany.set(companySlug, available);
  }

  return entries.map((entry) => {
    const [companySlug, section] = entry.id.split("/");
    const companyEntry = bySlug.get(companySlug);
    if (!companyEntry) throw new Error(`Missing company record for ${companySlug}`);
    const availableSections = availableByCompany.get(companySlug) ?? [];
    return { params: { company: companySlug, section }, props: { entry, companyEntry, availableSections } };
  });
}

const { entry, companyEntry, availableSections } = Astro.props as {
  entry: CollectionEntry<"companyResearch">;
  companyEntry: CollectionEntry<"companies">;
  availableSections: string[];
};
const company = companyEntry.data;
const section = entry.id.split("/").at(-1) ?? "overview";
const { Content } = await render(entry);
const claimFiles = await getCollection("claims");
const claim = claimFiles
  .flatMap((item) => item.data)
  .find((item) => item.id === company.primary_claim_id);
if (!claim) throw new Error(`Primary claim is missing for ${company.slug}`);
---

<CompanyShell current={section} title={entry.data.title} description={entry.data.description} company={company} claim={claim} availableSections={availableSections}>
  <Content />

  <div slot="signals">
    {company.slug === "muyuan" && section === "overview" && (
      <InferenceCard title="当前研究焦点" note="该解释仍需同行同口径成本数据验证。">
        单年成本改善值得继续拆解，但不能直接推出长期结构性成本优势。
      </InferenceCard>
    )}

    {company.slug === "muyuan" && section === "first-principles" && (
      <div class="signal-grid">
        <FactCard title="牧原不能决定市场猪价 P">猪价主要由行业供需与周期共同决定，公司只能管理自身暴露。</FactCard>
        <HypothesisCard title="长期竞争优势主要取决于 C" id={claim.id}>单位完全养殖成本是否能持续低于竞争者，仍是 OPEN CLAIM。</HypothesisCard>
      </div>
    )}

    {section === "thesis" && <ThesisCard claim={claim} />}
    {section === "evidence-log" && company.evidence.map((evidence) => <EvidenceCard evidence={evidence} />)}
    {section === "risks" && <div class="risk-grid">{company.risks.map((risk) => <RiskCard risk={risk} />)}</div>}
  </div>
</CompanyShell>
