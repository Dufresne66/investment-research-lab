---
import BaseLayout from "./BaseLayout.astro";
import { companySections } from "../lib/research";
import { withBase } from "../lib/paths";

interface Props {
  current: string;
  title: string;
  description: string;
  company: {
    slug: string;
    name: string;
    ticker: string;
    exchange: string;
    industry: string;
    last_updated: string;
    economic_model: { formula: string } | null;
    sources: unknown[];
  };
  claim: { id: string; status: string; confidence: number | null; statement: string };
  availableSections: string[];
}

const { current, title, description, company, claim, availableSections } = Astro.props;
const hasHumanConfidence = claim.confidence !== null;
const visibleSections = companySections.filter(([, slug]) => availableSections.includes(slug));
---

<BaseLayout title={`${company.name} · ${title}`} description={description} active="companies">
  <section class="company-masthead page-width">
    <a class="back-row" href={withBase()}>← Companies</a>
    <div class="company-heading">
      <div>
        <p class="section-label">COMPANY RESEARCH · {company.ticker}.{company.exchange}</p>
        <h1>{company.name}</h1>
        <p>{company.industry} · Research in progress · Updated {company.last_updated}</p>
      </div>
      <div class="company-equation">
        <span>ECONOMIC MODEL</span>
        <strong>{company.economic_model?.formula ?? "Model under review"}</strong>
      </div>
    </div>
  </section>

  <nav class="section-tabs" aria-label={`${company.name}研究章节`}>
    <div class="page-width tabs-inner">
      {visibleSections.map(([index, slug, label]) => (
        <a class:list={[slug === current && "active"]} href={withBase(`companies/${company.slug}/${slug}/`)}>
          <span>{index}</span>{label}
        </a>
      ))}
    </div>
  </nav>

  <div class="research-page page-width">
    <article class="research-document">
      <div class="document-meta">
        <span>RESEARCH NOTE</span>
        <span>{current.replaceAll("-", " ")}</span>
      </div>
      <div class="prose"><slot /></div>
      <div class="page-signals"><slot name="signals" /></div>
    </article>

    <aside class="research-aside">
      <section class="aside-card">
        <header><span>CORE CLAIM</span><b>{claim.status}</b></header>
        <code>{claim.id}</code>
        <p>{claim.statement}</p>
        <div class:list={["aside-confidence", !hasHumanConfidence && "is-unassigned"]}>
          {hasHumanConfidence && <i style={`width: ${claim.confidence}%`}></i>}
        </div>
        <small>{hasHumanConfidence ? `Human confidence · ${claim.confidence}%` : "Human not assigned"}</small>
      </section>
      <section class="aside-card">
        <header><span>SOURCE LIBRARY</span><b class="good">AVAILABLE</b></header>
        <strong>{company.sources.length} 份公开来源已登记</strong>
        <p>原始 PDF 与私人阅读笔记保存在研究层；本站只记录获准公开的引用、定位和判断变化。</p>
        <a class="aside-source-link" href={withBase(`companies/${company.slug}/reports/`)}>打开报告中心 →</a>
      </section>
      <section class="aside-card rule-card">
        <span>CONTENT RULE</span>
        <p><b>FACT</b> 指向来源；<b>INFERENCE</b> 写清推理；<b>HYPOTHESIS</b> 必须可反证。</p>
      </section>
      <section class="human-card"><span>H</span><div><small>INVESTMENT DECISION</small><strong>Human-written only</strong></div></section>
    </aside>
  </div>
</BaseLayout>
